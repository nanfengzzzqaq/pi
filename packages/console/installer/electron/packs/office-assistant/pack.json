{
	"name": "office-assistant",
	"displayName": "Office 文件处理",
	"description": "通过 OfficeCLI 创建、读取、编辑与检查 Word、Excel、PowerPoint 文件",
	"version": "0.3.0",
	"deferred": true,
	"metaTool": "office_enable",
	"activation": {
		"extensions": [".docx", ".xlsx", ".pptx"],
		"keywords": [
			"Office",
			"Word",
			"Excel",
			"PowerPoint",
			"PPT",
			"文档",
			"表格",
			"工作簿",
			"幻灯片",
			"演示文稿",
			"报告",
			"合同",
			"简历",
			"模板",
			"学术论文",
			"融资",
			"路演",
			"财务模型",
			"数据看板",
			"动态变形",
			"三维演示"
		],
		"minimumScore": 2,
		"defaultGroups": ["inspect"],
		"defaultSkillGroups": ["word", "pptx", "excel"]
	},
	"toolGroups": [
		{
			"name": "inspect",
			"displayName": "读取与检查",
			"description": "查看、读取、查询和检查 Office 文档",
			"tools": ["office_view", "office_get", "office_query", "office_help"],
			"keywords": ["查看", "读取", "分析", "检查", "查询", "预览", "统计", "问题", "内容", "是什么"]
		},
		{
			"name": "create",
			"displayName": "创建与生成",
			"description": "新建文档、批量生成、导入数据或合并模板",
			"tools": [
				"office_create",
				"office_add",
				"office_set",
				"office_batch",
				"office_import",
				"office_merge",
				"office_help"
			],
			"keywords": ["创建", "新建", "生成", "制作", "撰写", "做一份", "导入", "合并", "套用", "填写"]
		},
		{
			"name": "edit",
			"displayName": "编辑与修改",
			"description": "读取现有文档后修改、删除、移动或批量处理元素",
			"tools": [
				"office_view",
				"office_get",
				"office_query",
				"office_add",
				"office_set",
				"office_remove",
				"office_move",
				"office_swap",
				"office_batch",
				"office_help"
			],
			"keywords": ["修改", "编辑", "替换", "删除", "移动", "交换", "调整", "更新", "批量", "处理", "修复"]
		}
	],
	"skillGroups": [
		{
			"name": "word",
			"displayName": "Word 文档技能",
			"skills": ["officecli-docx"],
			"extensions": [".docx"],
			"keywords": ["Word", "文档", "合同", "报告", "简历", "模板"]
		},
		{
			"name": "academic",
			"displayName": "学术论文技能",
			"skills": ["officecli-docx", "officecli-academic-paper"],
			"keywords": ["学术", "论文", "参考文献", "脚注", "公式编号"]
		},
		{
			"name": "pptx",
			"displayName": "PowerPoint 技能",
			"skills": ["officecli-pptx"],
			"extensions": [".pptx"],
			"keywords": ["PowerPoint", "PPT", "演示文稿", "幻灯片"]
		},
		{
			"name": "pitch",
			"displayName": "融资路演技能",
			"skills": ["officecli-pptx", "officecli-pitch-deck"],
			"keywords": ["融资", "路演", "投资人", "种子轮", "A轮", "B轮", "C轮"]
		},
		{
			"name": "morph",
			"displayName": "动态变形演示技能",
			"skills": ["officecli-pptx", "morph-ppt"],
			"keywords": ["动态变形", "变形动画", "连续移动", "连续缩放", "Morph"]
		},
		{
			"name": "morph-3d",
			"displayName": "三维动态演示技能",
			"skills": ["officecli-pptx", "morph-ppt", "morph-ppt-3d"],
			"extensions": [".glb"],
			"keywords": ["三维演示", "3D演示", "三维模型", "镜头运动"]
		},
		{
			"name": "excel",
			"displayName": "Excel 工作簿技能",
			"skills": ["officecli-xlsx"],
			"extensions": [".xlsx", ".csv", ".tsv"],
			"keywords": ["Excel", "表格", "工作簿", "数据表"]
		},
		{
			"name": "finance",
			"displayName": "财务模型技能",
			"skills": ["officecli-xlsx", "officecli-financial-model"],
			"keywords": ["财务模型", "现金流", "估值", "敏感性分析", "经营预测"]
		},
		{
			"name": "dashboard",
			"displayName": "数据看板技能",
			"skills": ["officecli-xlsx", "officecli-data-dashboard"],
			"keywords": ["数据看板", "仪表盘", "指标卡", "迷你图"]
		}
	]
}
